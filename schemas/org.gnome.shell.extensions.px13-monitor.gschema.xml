<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.px13-monitor" path="/org/gnome/shell/extensions/px13-monitor/">
    <key name="refresh-interval" type="i">
      <default>2</default>
      <range min="1" max="30"/>
      <summary>Refresh interval</summary>
      <description>How often readings are updated, in seconds.</description>
    </key>
    <key name="show-cpu" type="b">
      <default>true</default>
      <summary>Show CPU temperature</summary>
    </key>
    <key name="show-gpu" type="b">
      <default>true</default>
      <summary>Show GPU temperature</summary>
    </key>
    <key name="show-fan" type="b">
      <default>true</default>
      <summary>Show fan speed</summary>
    </key>
    <key name="show-ram" type="b">
      <default>true</default>
      <summary>Show memory use</summary>
    </key>
    <key name="compact" type="b">
      <default>false</default>
      <summary>Compact layout</summary>
      <description>Place each fan speed beside its temperature.</description>
    </key>
    <key name="fan-pad" type="b">
      <default>true</default>
      <summary>Fixed-width fan speeds</summary>
      <description>Keep every fan speed the same width and dim the leading zeros.</description>
    </key>
    <key name="fan-digits" type="i">
      <default>4</default>
      <range min="2" max="6"/>
      <summary>Fan digits</summary>
      <description>How many digits a padded fan speed occupies.</description>
    </key>
    <key name="unit" type="s">
      <default>'celsius'</default>
      <choices>
        <choice value="celsius"/>
        <choice value="fahrenheit"/>
      </choices>
      <summary>Temperature unit</summary>
    </key>
    <key name="temp-high" type="i">
      <default>70</default>
      <range min="30" max="120"/>
      <summary>High temperature</summary>
      <description>Celsius at which temperatures turn yellow.</description>
    </key>
    <key name="temp-warn" type="i">
      <default>80</default>
      <range min="30" max="120"/>
      <summary>Warn temperature</summary>
      <description>Celsius at which temperatures turn orange.</description>
    </key>
    <key name="temp-crit" type="i">
      <default>90</default>
      <range min="30" max="120"/>
      <summary>Critical temperature</summary>
      <description>Celsius at which temperatures turn red.</description>
    </key>
    <key name="ram-high" type="i">
      <default>70</default>
      <range min="1" max="100"/>
      <summary>High memory use</summary>
      <description>Percent at which memory use turns yellow.</description>
    </key>
    <key name="ram-warn" type="i">
      <default>80</default>
      <range min="1" max="100"/>
      <summary>Warn memory use</summary>
      <description>Percent at which memory use turns orange.</description>
    </key>
    <key name="ram-crit" type="i">
      <default>95</default>
      <range min="1" max="100"/>
      <summary>Critical memory use</summary>
      <description>Percent at which memory use turns red.</description>
    </key>
  </schema>
</schemalist>
